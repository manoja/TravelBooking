# Copy to .env (never commit .env). Placeholders only.
# APP_ENV: development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Supabase: Project Settings > Database > Connection string. Keep sslmode=require.
# Transaction pooler (port 6543): also set DB_PGBOUNCER=true
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_PGBOUNCER=false

AUTH0_DOMAIN=<tenant>.auth0.com
AUTH0_AUDIENCE=<your-api-identifier>
# Only if different from https://<AUTH0_DOMAIN>/ (note the trailing slash)
AUTH0_ISSUER=
AUTH0_ALGORITHMS=RS256

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200

PENDING_HOLD_MINUTES=15
MAX_STAY_NIGHTS=30
TAX_RATE_PERCENT=0
FLAT_FEE=0
CANCELLATION_CUTOFF_DAYS=1
# Dummy payments default to on outside production. Leave unset in production.
# ENABLE_DUMMY_PAYMENTS=false
